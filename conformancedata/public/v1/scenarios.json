      "id": "RECALL-001",
      "intent_class": "project_context",
      "synthetic_input": "Continue the project using its established architecture.",
      "capabilities": {"memory": "available", "documents": "disabled", "todoist": "disabled"},
      "required_observations": ["tool_events", "user_visible_claims"],
      "assertions": {
        "must": [
          {"event": "tool_call", "capability": "memory", "operation": "recall"},
          {"event": "claim", "code": "fact_found"}
        ],
        "must_not": [{"event": "claim", "code": "preference_invented"}],
        "ordered": [{
          "before": {"event": "tool_call", "capability": "memory", "operation": "recall"},
          "after": {"event": "claim", "code": "fact_found"}
        }],
        "counts": [{
          "pattern": {"event": "tool_call", "capability": "memory", "operation": "recall"},
          "min": 1,
          "max": 1
        }]
      }
    },
