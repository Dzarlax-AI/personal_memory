name: personal-memory

services:
  memory-qdrant:
    image: qdrant/qdrant@sha256:f1c7272cdac52b38c1a0e89313922d940ba50afd90d593a1605dbbc214e66ffb
    platform: linux/arm64
    restart: unless-stopped
    volumes:
      - qdrant_storage:/qdrant/storage
      - qdrant_snapshots:/qdrant/snapshots
    healthcheck:
      test: ["CMD-SHELL", "bash -c ':> /dev/tcp/127.0.0.1/6333'"]
      interval: 5s
      timeout: 3s
      retries: 12

  memory-embeddings:
    image: @@TEI_IMAGE@@
    platform: linux/arm64
    command:
      - --model-id
      - intfloat/multilingual-e5-small
      - --revision
      - 614241f622f53c4eeff9890bdc4f31cfecc418b3
    restart: unless-stopped
    volumes:
      - tei_cache:/data
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:80/health"]
      start_period: 30m
      start_interval: 5s
      interval: 30s
      timeout: 5s
      retries: 3

  memory-mcp:
    image: @@APP_IMAGE@@
    platform: linux/arm64
    restart: unless-stopped
    depends_on:
      memory-qdrant:
        condition: service_healthy
      memory-embeddings:
        condition: service_healthy
    environment:
      MCP_PORT: "8000"
      QDRANT_URL: http://memory-qdrant:6333
      EMBED_URL: http://memory-embeddings:80
      EMBED_MODEL: intfloat/multilingual-e5-small
      EMBED_MODEL_REVISION: 614241f622f53c4eeff9890bdc4f31cfecc418b3
      EMBED_INPUT_PROFILE: legacy-raw-v1
      ADOPT_EXISTING_EMBEDDING_IDENTITY: "false"
      ALLOW_INSECURE_AUTH: "true"
      OAUTH_ENABLED: "false"
      ENABLE_RAG: "false"
      ENABLE_TODOIST: "false"
      ENABLE_VIZ: "false"
    ports:
      - "127.0.0.1:8000:8000"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8000/health"]
      interval: 10s
      timeout: 3s
      retries: 12

volumes:
  qdrant_storage:
  qdrant_snapshots:
  tei_cache:
