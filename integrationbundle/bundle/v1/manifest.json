  "source_identity": {
    "contract_sha256": "b425bb25ea0ecaa85ddaafacb9e5af9970d11a985a482b8d8fabcc612fa69668",
    "conformance_suite_sha256": "bd10ce7d22054210ad6798b3a75f48379ccb8063a52d620677b67b36509fcd1f"
  },
  "required_capabilities": [
    {"id": "ordinary_context", "tools": []}
  ],
  "optional_capabilities": [
    {"id": "memory", "tools": ["recall_facts", "store_fact", "update_fact", "set_fact_lifecycle"]},
    {"id": "documents", "tools": ["search_documents"]},
    {"id": "todoist", "tools": ["get_tasks", "create_task", "update_task", "complete_task", "delete_task"]}
  ],
  "optional_workflows": [
    {
      "id": "project_registration",
      "tool": "ensure_project",
      "trigger": "explicit_project_context_before_first_memory_or_document_tool_call",
      "input_fields": ["project_key", "namespace", "name", "tag", "summary", "evidence"],
      "requires_stable_key": true,
      "min_project_key_bytes": 8,
      "max_project_key_bytes": 128,
      "project_key_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
      "max_request_bytes": 8192,
      "max_summary_bytes": 2048,
      "max_evidence_items": 4,
      "max_evidence_bytes": 4096,
      "evidence_kinds": ["client_readme", "client_agents", "user_declared"],
      "statuses": ["created", "existing", "proposed_update", "ambiguous", "disabled", "unavailable"],
      "identity_statuses": ["created", "existing"],
      "output_fields": ["status", "project_id", "tag", "catalog_hash"],
      "failure_behavior": "continue_baseline_without_project_context_or_origin",
      "identity_use": "project_context_id_uses_returned_project_id; source_project_uses_returned_tag; subject_primary_tag_is_independent",
      "source_kind": "client_declared",
      "read_context_field": "project_context_id",
      "subject_field": "primary_tag"
    }
  ],
  "clients": [
    {
      "id": "codex",
      "artifact_format_version": "1.0.0",
