{
  "schema_version": 1,
  "bundle_version": "0.3.0",
  "contract_version": "1.0.0",
  "conformance_suite_version": "1.1.0",
  "workflow_suite_version": "1.1.0",
  "source_identity": {
    "contract_sha256": "b425bb25ea0ecaa85ddaafacb9e5af9970d11a985a482b8d8fabcc612fa69668",
    "conformance_suite_sha256": "bd10ce7d22054210ad6798b3a75f48379ccb8063a52d620677b67b36509fcd1f"
  },
  "required_capabilities": [
    {"id": "ordinary_context", "tools": []}
  ],
  "optional_capabilities": [
    {"id": "memory", "tools": ["recall_facts", "store_fact", "update_fact", "set_fact_lifecycle"]},
    {"id": "documents", "tools": ["search_documents"]},
    {"id": "todoist", "tools": ["get_tasks", "create_task", "update_task", "complete_task", "delete_task"]}
  ],
  "optional_workflows": [
    {
      "id": "project_registration",
      "tool": "ensure_project",
      "trigger": "explicit_project_context_before_first_memory_or_document_tool_call",
      "input_fields": ["project_key", "namespace", "name", "tag", "summary", "evidence"],
      "requires_stable_key": true,
      "min_project_key_bytes": 8,
      "max_project_key_bytes": 128,
      "project_key_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
      "max_request_bytes": 8192,
      "max_summary_bytes": 2048,
      "max_evidence_items": 4,
      "max_evidence_bytes": 4096,
      "evidence_kinds": ["client_readme", "client_agents", "user_declared"],
      "statuses": ["created", "existing", "proposed_update", "ambiguous", "disabled", "unavailable"],
      "identity_statuses": ["created", "existing"],
      "output_fields": ["status", "project_id", "tag", "catalog_hash"],
      "failure_behavior": "continue_baseline_without_project_context_or_origin",
      "identity_use": "project_context_id_uses_returned_project_id; source_project_uses_returned_tag; subject_primary_tag_is_independent",
      "source_kind": "client_declared",
      "read_context_field": "project_context_id",
      "subject_field": "primary_tag"
    },
    {
      "id": "write_recommendation",
      "tool": "get_write_recommendation",
      "trigger": "after_successful_eligible_store_fact_with_operation_reference",
      "input_fields": ["operation_ref"],
      "statuses": ["pending", "decided", "abstained", "failed", "outdated", "not_found", "unavailable"],
      "output_fields": ["status", "applied", "suggested_primary_tag", "recommended_related_tags", "subject_decision", "reason_code", "missing_context_codes"],
      "failure_behavior": "preserve_baseline_fact_and_grouping; disclose_distinct_status_without_automatic_inference_retry",
      "capability": "get_write_recommendation",
      "eligible_outcome": "store_fact_success_with_ai_operation_ref",
      "reference_field": "ai.operation_ref_or_text_fallback_ai_operation_ref",
      "read_limit": 1,
      "pending_read_limit": 1,
      "terminal_statuses": ["decided", "abstained", "failed", "outdated", "not_found", "unavailable"],
      "apply_behavior": "never_apply_suggested_or_related_tags_automatically",
      "consent_behavior": "never_add_allow_ai_processing_or_infer_consent"
    }
  ],
  "clients": [
    {
      "id": "codex",
      "artifact_format_version": "1.0.0",
      "artifacts": [
        {"path": "codex/AGENTS.personal-memory.md", "template": "templates/codex-agents.md.tmpl"},
        {"path": "codex/skills/personal-memory/SKILL.md", "template": "templates/codex-skill.md.tmpl"}
      ],
      "override_paths": ["overrides/codex/AGENTS.local.md"]
    },
    {
      "id": "claude",
      "artifact_format_version": "1.0.0",
      "artifacts": [
        {"path": "claude/rules/personal-memory.md", "template": "templates/claude-rules.md.tmpl"},
        {"path": "claude/skills/personal-memory/SKILL.md", "template": "templates/claude-skill.md.tmpl"},
        {"path": "claude/settings.personal-memory.json", "template": "templates/claude-settings.json.tmpl"}
      ],
      "override_paths": ["overrides/claude/personal-memory.local.md"]
    },
    {
      "id": "chatgpt",
      "artifact_format_version": "1.0.0",
      "artifacts": [
        {"path": "chatgpt/behavior-prompt.md", "template": "templates/chatgpt-prompt.md.tmpl"},
        {"path": "chatgpt/remote-mcp-registration.json", "template": "templates/chatgpt-registration.json.tmpl"}
      ],
      "override_paths": ["overrides/chatgpt/behavior.local.md"]
    },
    {
      "id": "generic_mcp",
      "artifact_format_version": "1.0.0",
      "artifacts": [
        {"path": "generic-mcp/policy.json", "template": "templates/generic-policy.json.tmpl"},
        {"path": "generic-mcp/tool-mapping.json", "template": "templates/generic-tools.json.tmpl"}
      ],
      "override_paths": ["overrides/generic-mcp/policy.local.json"]
    }
  ],
